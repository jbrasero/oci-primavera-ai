limit_req_zone $binary_remote_addr zone=primavera_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PUBLIC_HOST};

    ssl_certificate /etc/nginx/tls/primavera-agentica.crt;
    ssl_certificate_key /etc/nginx/tls/primavera-agentica.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:primavera_tls:10m;
    ssl_session_timeout 1d;

    client_max_body_size 40m;
    proxy_connect_timeout 15s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Entrada aislada para el Portlet Block de Primavera Unifier. Esta ubicación
    # sustituye los add_header del servidor y omite X-Frame-Options a propósito.
    location = /unifier-portlet {
        rewrite ^ /index.html break;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'self' ${UNIFIER_PARENT_ORIGIN}; base-uri 'self'; form-action 'self'" always;
    }

    location = /unifier-portlet/ {
        return 308 /unifier-portlet$is_args$args;
    }

    location = /api/auth/login {
        limit_req zone=primavera_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
