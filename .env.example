# Never commit your real credentials. Use a secret manager or your MCP client configuration.
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-this-before-running
# Session lifetime for the local web interface.
APP_AUTH_SESSION_HOURS=8
# Enable only when the web interface is served over HTTPS.
APP_AUTH_SECURE_COOKIE=false

UNIFIER_BASE_URL=https://your-unifier-host.example.com/companycode/unifier
UNIFIER_USERNAME=integration-user
UNIFIER_PASSWORD=replace-with-secret
UNIFIER_AUTH_MODE=credentials

# Alternative to username/password. Do not configure both unless you understand
# the precedence described in README.md.
# UNIFIER_ACCESS_TOKEN=replace-with-short-lived-token
# UNIFIER_TOKEN_AUTH_SCHEME=Bearer

# Mutating REST methods (POST, PUT, PATCH, DELETE) require this explicit opt-in.
UNIFIER_ALLOW_WRITE=false

# Document Intake: PDFs are sent directly to the configured Responses API for analysis.
# They are not persisted by this local server. Limit per uploaded PDF (default: 8).
CONTRACT_INTAKE_MAX_FILE_MB=8

# Required only to create a Contract BP with its uploaded PDFs in Unifier.
# Use technical IDs from uDesigner; never use the visible field labels.
# CONTRACT_BP_NAME=your_contract_bp_technical_name
# CONTRACT_FIELD_MAP_JSON={"title":"uuu_title","contractNumber":"uuu_contract_number","amount":"uuu_amount"}

# OCI Enterprise AI Agents / OCI Responses API.
OCI_GENAI_API_KEY=replace-with-oci-enterprise-ai-api-key
OCI_GENAI_REGION=your-oci-region
OCI_GENAI_PROJECT_OCID=ocid1.genaiagentproject.replace-me
OCI_GENAI_MODEL=replace-with-supported-model-id
# OCI_GENAI_BASE_URL=https://inference.generativeai.your-region.oci.oraclecloud.com/openai/v1

# IAM profile alternative to OCI_GENAI_API_KEY.
# OCI_GENAI_PROFILE=DEFAULT

# Optional RAG and monitoring.
# OCI_VECTOR_STORE_ID=replace-with-vector-store-id
AGENT_MONITOR_INTERVAL_MINUTES=0

# Project Autopilot: daily read-only comparison while the web process is running.
PROJECT_AUTOPILOT_HOUR=8
PROJECT_AUTOPILOT_MINUTE=0
PROJECT_AUTOPILOT_TIMEZONE=Europe/Madrid
# Minimum absolute change for numeric financial totals to open an alert.
PROJECT_AUTOPILOT_AMOUNT_DELTA=1000
# Set only in tests or when an external scheduler owns execution.
# PROJECT_AUTOPILOT_SCHEDULER=false

# Durable location used by the web process for Autopilot state.
PROJECT_AUTOPILOT_STATE_PATH=./data/project-autopilot.json
